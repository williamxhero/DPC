{
  "name": "dpc",
  "version": "0.1.0",
  "private": true,
  "description": "Durable Plan Continuation core",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/**/*.test.js",
    "test:cloudflare": "npm run build && node --test tests/cloudflare-live.test.js",
    "test:needs-forever": "npm run build && node --test tests/needs-forever-live.test.js",
    "test:postgres": "npm run build && node --test tests/postgres.test.js",
    "check": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@types/pg": "^8.10.2",
    "pg": "^8.13.1"
  }
}
